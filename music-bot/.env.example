# --- required ---
BOT_TOKEN=123456:ABC...
# Public HTTPS address of this service (serverless URL). Webhook + Mini App are served from it.
PUBLIC_URL=https://your-app.example.com

# --- optional ---
# Random string; Telegram sends it back in every webhook call so fake updates are rejected
WEBHOOK_SECRET=change-me
# polling = run locally without a public URL, webhook = serverless/production
MODE=webhook
PORT=8080
DATA_DIR=./data

# Extra recognisers (Shazam works without a key)
AUDD_API_TOKEN=
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
# Humming project on ACRCloud (separate project with "humming" bucket)
ACRCLOUD_HUM_ACCESS_KEY=
ACRCLOUD_HUM_ACCESS_SECRET=

# Speech-to-text for "user sings the words" (any OpenAI-compatible endpoint: OpenAI, Groq, ...)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# Lyrics search (genius.com API client token)
GENIUS_TOKEN=

# yt-dlp: path to a cookies.txt if YouTube asks for sign-in on your server IP
YTDLP_COOKIES=
# Max size the bot will upload (50 MB is the cloud Bot API limit; raise only with a local Bot API server)
MAX_UPLOAD_MB=50
