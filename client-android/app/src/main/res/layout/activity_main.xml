<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="KANKI Tunnel" android:textSize="24sp" android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etServer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Server IP / host"
        android:inputType="textUri"/>
    <EditText android:id="@+id/etPort" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Server port (4000)"
        android:inputType="number"/>
    <EditText android:id="@+id/etLocal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Local listen port (5000)"
        android:inputType="number"/>
    <EditText android:id="@+id/etKey" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="PSK — 64 hex chars"
        android:inputType="textPassword"/>

    <TextView android:id="@+id/tvRepeat" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="Repeat: 4x"/>
    <SeekBar android:id="@+id/sbRepeat" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText android:id="@+id/etFecK" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="FEC block size k (8)"
        android:inputType="number"/>
    <EditText android:id="@+id/etJitter" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Jitter µs (1500, 0 = off)"
        android:inputType="number"/>
    <CheckBox android:id="@+id/cbFec" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="FEC enabled" android:checked="true"/>
    <CheckBox android:id="@+id/cbAutotune" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Auto-tune repeat (3–10)"/>

    <Button android:id="@+id/btnToggle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Start"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="○ Idle"/>
</LinearLayout>
