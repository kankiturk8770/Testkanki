<resources>
    <style name="KankiTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#06142A</item>
        <item name="android:windowBackground">@drawable/screen</item>
        <item name="colorAccent">#9F8CFF</item>
        <item name="android:colorAccent">#9F8CFF</item>
        <item name="android:textColorPrimary">#F2F5FF</item>
    </style>
    <style name="KankiField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#F2F5FF</item>
        <item name="android:textColorHint">#8C93B8</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="KankiCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="KankiLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#A9A2FF</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="KankiButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="KankiGlassButton" parent="KankiButton">
        <item name="android:background">@drawable/btn_glass</item>
        <item name="android:textColor">#E6E9FF</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="KankiTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/tile</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_margin">5dp</item>
    </style>
    <style name="KankiTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:text">—</item>
    </style>
    <style name="KankiTileCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8C93B8</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
</resources>
